# =====================================================================
# HYDROPAY — PLANTILLA DE CONFIGURACIÓN (.env.example)
# Copia este archivo como .env y ejecuta: php artisan key:generate
# Este archivo SÍ se sube a GitHub; NO debe contener contraseñas reales.
# El archivo .env (con tus valores) NUNCA se sube (está en .gitignore).
# =====================================================================

# --- Aplicación ---
APP_NAME=HydroPay
# local en desarrollo; production en un servidor real.
APP_ENV=local
# Se genera con "php artisan key:generate". Déjala vacía aquí.
APP_KEY=
# true solo en desarrollo. En producción SIEMPRE false (no mostrar errores técnicos).
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# --- Idioma (localización) ---
APP_LOCALE=es
# Si falta una traducción en español se usa inglés en lugar de mostrar la clave.
APP_FALLBACK_LOCALE=en
# Idioma de los datos ficticios (Faker no incluye es_MX; es_ES genera nombres y direcciones en español).
APP_FAKER_LOCALE=es_ES

# --- Mantenimiento y seguridad ---
APP_MAINTENANCE_DRIVER=file
# Costo del hash bcrypt de las contraseñas.
BCRYPT_ROUNDS=12

# --- Registro de eventos (Logging) ---
LOG_CHANNEL=stack
# daily crea un archivo por día en storage/logs y conserva LOG_DAILY_DAYS días.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# debug en desarrollo; warning o error en producción.
LOG_LEVEL=debug

# --- Base de datos ---
# SQLite para desarrollo local. Si DB_DATABASE se omite se usa database/database.sqlite.
DB_CONNECTION=sqlite
# Para MySQL/MariaDB en producción descomenta y completa:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hydropay
# DB_USERNAME=hydropay
# DB_PASSWORD=

# --- Sesiones ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
# En producción con HTTPS: SESSION_ENCRYPT=true y SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Servicios internos ---
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Correo (Mail / Notifications) ---
# "log" escribe los correos en storage/logs (sirve para probar la recuperación de contraseña).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hydropay@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- HydroPay (config/hydropay.php) ---
# Nombre del organismo que aparece en reportes y pie de página.
HYDROPAY_ORGANISMO="Organismo operador de agua"
# Horas de vigencia de los tokens de la API (Laravel Sanctum).
HYDROPAY_API_TOKEN_HORAS=8
