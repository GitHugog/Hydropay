      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Cuenta única para cada ejecución (evita el error de cuenta duplicada).",
          "if (!pm.collectionVariables.get('cuenta')) { pm.collectionVariables.set('cuenta', 'HP-PM-' + Date.now()); }"
        ]
      }
    }
